# Copy to .env and fill in real values for local development.
# Never commit a real .env file.

DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=nasat_lims
POSTGRES_USER=nasat_lims
POSTGRES_PASSWORD=devpassword
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Alibaba Cloud OSS (S3-API-compatible object storage, Manila region) via
# boto3 (apps/audit/oss.py). For local dev, run a local MinIO server
# instead and point OSS_ENDPOINT at it -- same client code either way:
#   minio.exe server <data-dir> --console-address ":9001"
#   (with MINIO_ROOT_USER / MINIO_ROOT_PASSWORD env vars set to match
#   OSS_ACCESS_KEY_ID / OSS_ACCESS_KEY_SECRET below)
OSS_BUCKET_NAME=nasat-lims-dev
OSS_ENDPOINT=https://oss-ap-southeast-6.aliyuncs.com
OSS_ACCESS_KEY_ID=change-me
OSS_ACCESS_KEY_SECRET=change-me
# archive_object()'s target storage class for "archive to cold storage"
# (Blueprint Section 7.4a). S3-compatible backends disagree on which values
# they accept -- MinIO's default config only recognizes
# STANDARD/REDUCED_REDUNDANCY, rejecting AWS-standard STANDARD_IA/GLACIER
# outright. Set to whatever Alibaba OSS's S3-compatible surface actually
# expects (verify against a real account; not confirmed here).
OSS_ARCHIVE_STORAGE_CLASS=REDUCED_REDUNDANCY
OSS_PRESIGNED_URL_EXPIRY_SECONDS=900

# Entra ID (Azure AD) App Registration for staff SSO (Blueprint Section 2.1
# item 7). Create one in the Azure Portal under App registrations, single
# tenant, Web platform redirect URI http://localhost:8000/oauth2/callback
# for local dev. Required for the app to even boot -- see config/settings.py.
AZURE_AD_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_AD_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_AD_CLIENT_SECRET=change-me

# Email. The console backend prints messages (including customer verification
# links) to the runserver log, which is what you want locally -- nothing
# leaves the machine. For a real transport, pick ONE of the two below;
# config/settings.py refuses to start with DEBUG off if either is half-filled,
# since a silently-not-sending deployment is the failure mode that reaches the
# customer before it reaches you.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=no-reply@nasatlabs.test

# --- Transport 1: Microsoft Graph, as an M365 shared mailbox (preferred) ----
# If the domain is already in M365 then SPF/DKIM/DMARC are done, there is no
# DNS work, and the lab has one external mail provider rather than two. See
# infra/m365-graph-mail.md -- and narrow the Mail.Send permission with an
# Exchange application access policy before putting the secret anywhere.
#
# The credential is its own app registration, NOT the AZURE_AD_* one that signs
# staff in: rotating the mail secret must not be able to lock the lab out.
# DJANGO_EMAIL_BACKEND=apps.notifications.graph.GraphEmailBackend
# GRAPH_MAIL_CLIENT_ID=22222222-2222-2222-2222-222222222222
# GRAPH_MAIL_CLIENT_SECRET=change-me     # the secret Value, not the Secret ID
# GRAPH_MAIL_SENDER=lims-notifications@your-domain   # the shared mailbox
# GRAPH_MAIL_TENANT_ID=                  # falls back to AZURE_AD_TENANT_ID
# GRAPH_MAIL_SAVE_TO_SENT_ITEMS=true     # a copy in the mailbox, as a record
# GRAPH_MAIL_TIMEOUT=10
#
# DJANGO_DEFAULT_FROM_EMAIL must be GRAPH_MAIL_SENDER (a display name in front
# is fine). Graph rewrites the From to the mailbox it is scoped to rather than
# refusing, so settings.py refuses to start on a mismatch instead.

# --- Transport 2: an SMTP relay (fallback, for no-M365 deployments) ---------
# Provider-agnostic; the values come from whichever relay's console. The port
# and TLS mode are already the defaults in config/settings.py -- 465 with
# implicit TLS, which cannot be downgraded the way STARTTLS on 587 can -- so
# only the host and credentials need setting.
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.your-provider.example
# EMAIL_HOST_USER=no-reply@your-verified-domain   # the sender address
# EMAIL_HOST_PASSWORD=change-me        # the address's SMTP password, not your account password
# For a relay that wants STARTTLS instead, change all three together --
# settings.py refuses to start on a port that contradicts the TLS mode:
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false
# Seconds. Django does not default this, and smtplib blocks forever without
# it -- two hung sends would stall the whole Celery worker.
EMAIL_TIMEOUT=10
