# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/

# Virtual environments
venv/
env/
.venv/

# Django
backend/db.sqlite3
staticfiles/
media/

# Environment / secrets
.env
*.env.local

# Celery
celerybeat-schedule
celerybeat-schedule.*
celerybeat.pid

# MinIO local dev data
.minio-data/

# Claude Code local settings
.claude/settings.local.json
.claude/scheduled_tasks.lock

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Logs
*.log

# Terraform (infra/). State can contain database passwords in plain text,
# and .terraform/ holds downloaded provider binaries.
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
# .terraform.lock.hcl is deliberately NOT ignored: it pins provider versions
# and hashes, and belongs in version control so every machine and CI run
# resolves the same provider build.

# Test artifacts
.pytest_cache/
htmlcov/
.coverage

# Redis snapshots. redis-server writes dump.rdb into whatever directory it
# was started from, so running it from backend/ during local testing drops
# one into the tree. It is a binary database file that changes constantly
# and can hold session keys and cache contents -- never versioned.
*.rdb
